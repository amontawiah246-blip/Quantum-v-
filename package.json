    "test:quantum": "tsx --test src/quantumEngines.test.ts src/intelBacktest.test.ts src/intelEvaluator.test.ts",
    "backtest:intel": "tsx src/engineBacktestCli.ts --intel",
    "test:hybrid": "tsx --test src/hybrid.test.ts",
    "hybrid:dataset": "tsx src/hybridCli.ts dataset",
    "hybrid:diagnose": "tsx src/hybridCli.ts diagnose",
    "hybrid:train": "python3 ml/train.py",
    "test:hybridauto": "tsx --test src/hybridAutotrading.test.ts src/hybrid.test.ts src/aiVerification.test.ts src/signal.test.ts",
    "test:modes": "tsx --test src/modes.test.ts",
    "test:candidates": "tsx --test src/agentAutotrade.test.ts src/candidateBroadcast.test.ts src/sweepWatcher.test.ts src/signal.test.ts src/aiVerification.test.ts",
    "test:lscc": "tsx --test src/lscc.test.ts",
